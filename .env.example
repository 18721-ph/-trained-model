# Development only. Keep this file secret-free.
APP_ENV=development
AUTH_DATABASE_PATH=data/runtime/auth.sqlite3
SESSION_COOKIE_NAME=ldrp_session
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set SESSION_COOKIE_SECURE=true with HTTPS in production.
